# Hermes is optional during UI development; mock mode is used when no URL is set.
HERMES_GATEWAY_URL=
HERMES_API_KEY=
HERMES_AGENT_NAME=Lappy
HERMES_SESSION_ID=
# Set only after confirming the gateway protocol and documented paths.
HERMES_ADAPTER=mock
HERMES_CHAT_COMPLETIONS_PATH=
HERMES_HEALTH_PATH=
HERMES_RESPONSE_TIMEOUT_MS=90000

WAKE_WORD_ENABLED=true
WAKE_WORD_PROVIDER=local
CAMERA_ENABLED=false
TTS_PROVIDER=fish-audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free
STT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

LAPPY_HOST=127.0.0.1
LAPPY_PORT=4318
LAPPY_DEBUG_RECORDING=false
LAPPY_ALLOW_RESTART=false
LAPPY_ALLOW_KIOSK_CONTROL=false
