[Unit]
Description=Lappy Chromium kiosk
After=lappy.service
Wants=lappy.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
UMask=0077
ExecStartPre=/home/terminal/Lappy/scripts/wait-for-lappy.sh
ExecStart=/home/terminal/Lappy/scripts/start-kiosk.sh
Restart=always
RestartSec=4
TimeoutStopSec=8
KillSignal=SIGTERM

[Install]
WantedBy=default.target
